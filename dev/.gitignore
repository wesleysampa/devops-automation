### Ansible ###
*.retry

### Git ###
# Created by git for backups. To disable backups in Git:
# $ git config --global mergetool.keepBackup false
*.orig

# Created by git when using merge tools for conflicts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*_BACKUP_*.txt
*_BASE_*.txt
*_LOCAL_*.txt
*_REMOTE_*.txt

# Editor
*.vscode
.swp

# Local .terraform directories
**/.terraform/*

### Terraform ###
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Ignore CLI configuration files
terraform.rc
*terraform.rc
*.terraform
terraform.tfstate
terraform.tfstate.*
.terraform.lock.hcl
.terraformrc

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files to ignore the plan output
*tfplan*
*.tfplan

### Ignore Temporary and System Files
# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Windows files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux files / Editors
*.swp
*.swo
*~
.vscode/
.idea/

### Do Not Version Credentials and Local Configurations
# Credential and environment variable files
.env
.env.local
.env.*.local
config/secrets.yml

### Ignore Dependencies and Builds
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java
*.class
*.jar
*.war
*.ear

### General Logs
*.log